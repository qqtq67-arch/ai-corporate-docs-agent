    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH q AS (UPDATE rag_quality_outbox SET status='sending' WHERE request_id=$1 AND status='pending' RETURNING request_id,question,email) SELECT * FROM q;",
        "options": {
          "queryReplacement": "={{ [$json.request_id] }}"
        }
      },
      "name": "04 Зарезервировать заявку",
