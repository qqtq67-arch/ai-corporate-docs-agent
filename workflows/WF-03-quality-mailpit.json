      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst id=$('02 Режим работы').first().json.request_id;\nconst messages=r.messages;\nif(!Array.isArray(messages)) throw Error('Неизвестный формат списка Mailpit');\nconst m=messages.find(m=>String(m.From?.Address??'').toLowerCase()==='quality@example.test' && m.Subject===`[RAG-${id}] Ответ эксперта` && (m.To??[]).some(a=>String(a.Address??'').toLowerCase()==='assistant@example.test'));\nif(!m) return [];\nreturn [{json:{message_id:m.ID,request_id:id}}];"
      },
