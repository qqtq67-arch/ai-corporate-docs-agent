        "jsCode": "\nconst mode = 'receive';\nconst request_id = '0';\n\nconst expert_answer = '';\n\nif (!['send', 'reply', 'receive'].includes(mode)) {\n  throw Error('Неверный режим');\n}\n\nif (!/^[0-9]+$/.test(request_id)) {\n  throw Error('Укажите номер заявки');\n}\n\nif (mode === 'reply' &&\n    (!expert_answer.trim() || expert_answer.length > 2000)) {\n  throw Error('Введите разъяснение до 2000 символов');\n}\n\nreturn [{\n  json: {\n    mode,\n    request_id,\n    expert_answer: expert_answer.trim()\n  }\n}];\n"
      },
