    {
      "parameters": {
        "jsCode": "const allowed=new Set($('19 Ожидающие ответ').all().map(x=>String(x.json.request_id)));const out=new Map();for(const item of $input.all()){const messages=item.json.messages;if(!Array.isArray(messages))throw Error('Некорректный ответ Mailpit');for(const m of messages){const match=String(m.Subject??'').match(/^\\[RAG-(\\d+)\\] Ответ эксперта$/);if(!match||!allowed.has(match[1])||!m.ID||String(m.From?.Address??'').toLowerCase()!=='quality@example.test'||!(m.To??[]).some(a=>String(a.Address??'').toLowerCase()==='assistant@example.test'))continue;if(!out.has(match[1]))out.set(match[1],{json:{request_id:match[1],message_id:m.ID}});}}return [...out.values()];"
      },
