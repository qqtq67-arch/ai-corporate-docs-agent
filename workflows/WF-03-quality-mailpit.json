    {
      "parameters": {
        "method": "POST",
        "url": "http://mailpit:8025/api/v1/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({From:{Email:\"quality@example.test\"},To:[{Email:\"assistant@example.test\"}],Cc:[{Email:\"employee@example.test\"}],Subject:\"[RAG-\"+$json.request_id+\"] Ответ эксперта\",Text:$(\"02 Режим работы\").first().json.expert_answer}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "09 Отправить ответ эксперта",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        544
      ],
      "id": "a2302b53-5eb0-4ca1-820e-d560a509cea3"
    },
    {
      "parameters": {
        "url": "={{ \"http://mailpit:8025/api/v1/search?limit=50&query=\" + encodeURIComponent(\"from:quality@example.test to:assistant@example.test subject:RAG-\" + $(\"02 Режим работы\").first().json.request_id) }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "10 Найти письмо эксперта",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1344,
        800
      ],
      "id": "55526ec7-269d-43df-85a7-922b20cc3702"
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst id=$('02 Режим работы').first().json.request_id;\nconst messages=r.messages;\nif(!Array.isArray(messages)) throw Error('Неизвестный формат списка Mailpit');\nconst m=messages.find(m=>String(m.From?.Address??'').toLowerCase()==='quality@example.test' && m.Subject===`[RAG-${id}] Ответ эксперта` && (m.To??[]).some(a=>String(a.Address??'').toLowerCase()==='assistant@example.test'));\nif(!m) return [];\nreturn [{json:{message_id:m.ID,request_id:id}}];"
      },
      "name": "11 Проверить отправителя и тему",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        800
      ],
      "id": "a05dbb71-3789-4fef-86e2-83cd25e91df3"
    },
    {
      "parameters": {
        "url": "={{ \"http://mailpit:8025/api/v1/message/\" + encodeURIComponent($json.message_id) }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "12 Прочитать письмо",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1776,
        800
      ],
      "id": "3dff8dd3-7abf-44be-9894-1871132a76ae"
    },
    {
      "parameters": {
        "jsCode": "const m=$input.first().json;\nconst id=$('02 Режим работы').first().json.request_id;\nif(String(m.From?.Address??'').toLowerCase()!=='quality@example.test' || m.Subject!==`[RAG-${id}] Ответ эксперта` || !(m.To??[]).some(a=>String(a.Address??'').toLowerCase()==='assistant@example.test')) throw Error('Письмо не прошло проверку');\nconst answer=String(m.Text??'').trim();\nif(!answer || answer.length>2000) throw Error('Некорректный текст экспертного ответа');\nreturn [{json:{request_id:id,expert_answer:answer}}];"
      },
      "name": "13 Проверить текст разъяснения",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        800
      ],
      "id": "8befd253-5c74-4b90-88d7-8f9f973c6c44"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE rag_quality_outbox SET expert_answer=$2, status='answered', answered_at=now() WHERE request_id=$1 AND status='sent' RETURNING request_id,status,expert_answer,answered_at;",
        "options": {
          "queryReplacement": "={{ [$json.request_id,$json.expert_answer] }}"
        }
      },
      "name": "14 Сохранить разъяснение",
