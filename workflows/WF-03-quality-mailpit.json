        "jsCode": "const ids=new Set($('21 Отбор писем эксперта').all().map(x=>String(x.json.request_id)));const out=[];for(const item of $input.all()){const m=item.json;const match=String(m.Subject??'').match(/^\\[RAG-(\\d+)\\] Ответ эксперта$/);const answer=String(m.Text??'').trim();if(!match||!ids.has(match[1])||String(m.From?.Address??'').toLowerCase()!=='quality@example.test'||!(m.To??[]).some(a=>String(a.Address??'').toLowerCase()==='assistant@example.test')||!answer||answer.length>2000)continue;out.push({json:{request_id:match[1],expert_answer:answer}});}return out;"
